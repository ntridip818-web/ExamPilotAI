DATABASE_URL=postgresql://username:password@host:5432/exampilotai
OPENAI_API_KEY=your-openai-key-here
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed if your Supabase project still signs JWTs with a legacy HS256 secret.
# Leave unset for projects using the JWKS signing-key endpoint.
SUPABASE_JWT_SECRET=
ADMIN_SUPABASE_UIDS=your-admin-supabase-user-uuid
CLEANUP_TOKEN=your-existing-cleanup-token
CORS_ORIGINS=https://your-frontend.example.com
